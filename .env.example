# docker compose 변수 전용 — 앱 설정은 backend/.env·frontend/.env에 둔다.
# compose backend 서비스가 이 파일을 env_file로 읽어 환경변수로 주입하므로(backend/.env보다 우선),
# 앱 설정 키를 여기에 예시값으로 두면 backend/.env의 실제 값을 덮어써 기동에 실패한다.

# Database (db 서비스 + backend 컨테이너의 DATABASE_URL)
POSTGRES_PASSWORD=your-postgres-password-here

# Grafana 관리자 비밀번호 (--profile monitoring 필수)
GRAFANA_PASSWORD=your-grafana-password-here

# 자체 호스팅 nginx 이미지 빌드 인자 (--profile production). 웹은 상대 /api라 API 도메인 불필요
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_REDIRECT_URL=
VITE_SENTRY_DSN=
